---
import { ArrowUpRight, Download, ShieldCheck, Upload } from '@lucide/astro';
import '../styles/tokens.css';
import '../styles/app.css';
import { publicPage } from '../lib/site.ts';
import { description, faviconQuestions } from '../lib/help.ts';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalURL = publicPage(Astro.site, basePath);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'VINASIG Favicon Forge',
  url: canonicalURL.href,
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  browserRequirements: 'Requires JavaScript and Canvas support.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f6f4" />
    <meta name="description" content={description} />
    <meta property="og:title" content="VINASIG Favicon Forge" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="VINASIG Favicon Forge" />
    <meta name="twitter:description" content={description} />
    <link
      rel="sitemap"
      type="application/xml"
      href={`${basePath}sitemap.xml`}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
    <link
      rel="preload"
      href={`${basePath}fonts/SpaceGrotesk-VariableFont_wght.ttf`}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="stylesheet" href={`${basePath}fonts/font.css`} />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link
      rel="icon"
      href={`${basePath}brand/favicon-16.png`}
      type="image/png"
      sizes="16x16"
    />
    <link
      rel="icon"
      href={`${basePath}brand/favicon-32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="icon"
      href={`${basePath}brand/favicon-48.png`}
      type="image/png"
      sizes="48x48"
    />
    <title>VINASIG Favicon Forge - Generate favicons from your logo</title>
  </head>
  <body>
    <a class="skip-link" href="#generator">
      Skip to generator
    </a>
    <header class="site-header page-shell">
      <div class="brand">
        <a
          class="brand-link"
          href="https://github.com/VINASIG"
          aria-label="VINASIG on GitHub"
        >
          <img
            src={`${basePath}brand/primary-color.svg`}
            width="162"
            height="42"
            alt="VINASIG"
          />
        </a>
        <span class="product-name">Favicon Forge</span>
      </div>
      <a class="source-link" href="https://github.com/VINASIG/favicon-forge">
        View source <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </header>
    <main class="page-shell">
      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">Generate favicons</h1>
        <p>Drop one logo. Download the complete package.</p>
      </section>

      <section class="workspace" id="generator" aria-label="Favicon generator">
        <input
          id="file-input"
          type="file"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
          aria-label="Logo image"
          hidden
        />
        <button
          class="drop-zone"
          id="drop-zone"
          type="button"
          aria-label="Choose or drop a logo"
          aria-describedby="drop-subtitle"
        >
          <span class="drop-icon" aria-hidden="true">
            <Upload size={24} />
          </span>
          <span class="drop-copy">
            <span class="drop-title" id="drop-title">
              Drop or choose a logo
            </span>
            <span class="drop-subtitle" id="drop-subtitle">
              PNG, JPG, WebP or SVG. Up to 10 MB.
              <br />
              512 × 512 or larger recommended.
            </span>
          </span>
        </button>

        <p class="privacy-note">
          <ShieldCheck size={18} aria-hidden="true" />
          Your image stays in your browser.
        </p>

        <p class="error-message" id="error-message" role="alert" hidden></p>

        <div class="result-panel" id="result-panel" hidden>
          <div class="result-header">
            <h2>Preview</h2>
          </div>

          <div class="preview-layout">
            <div class="source-preview">
              <div class="preview-label">Source logo</div>
              <div class="source-frame checkerboard">
                <img
                  class="pixelated"
                  id="source-preview"
                  src="data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%221%22%20height=%221%22/%3E"
                  alt="Selected logo"
                />
              </div>
              <div class="file-meta" id="file-meta"></div>
            </div>

            <div class="generated-previews">
              <div class="preview-label">Output sizes</div>
              <div class="output-surface checkerboard">
                <div class="preview-grid pixel-mode" id="preview-grid"></div>
              </div>
            </div>
          </div>

          <button class="download-button" id="download-button" type="button">
            <span id="download-label">Download package</span>
            <Download class="download-icon" size={20} aria-hidden="true" />
            <span class="spinner" aria-hidden="true" hidden></span>
          </button>
          <p class="package-note">
            Includes browser icons, app icons, a web manifest and setup
            instructions.
          </p>
        </div>
      </section>
      <div class="help">
        <section aria-labelledby="setup-heading">
          <h2 id="setup-heading">How to use your favicon package</h2>
          <p>{description}</p>
          <p>
            Favicons identify your website in browser tabs and bookmarks. The
            package also includes larger icons for saved or installed web apps.
          </p>
          <ol class="setup-steps">
            <li>
              Choose a logo, review the previews and download the ZIP package.
            </li>
            <li>
              Extract the icons and <code>site.webmanifest</code> into your
              site's public folder. Copy the markup from{' '}
              <code>favicon-snippet.html</code> into your page's{' '}
              <code>&lt;head&gt;</code> and adjust paths if the icons are in a
              different folder.
            </li>
            <li>
              Edit the name, colors, start URL and scope in{' '}
              <code>site.webmanifest</code> for your website. Build and deploy,
              then check that the linked icon files load.
            </li>
          </ol>
          <p class="help-reference">
            <a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Attributes/rel#icon">
              MDN guide to favicon links
            </a>
          </p>
        </section>
        <section aria-labelledby="questions-heading">
          <h2 id="questions-heading">Common questions</h2>
          {faviconQuestions.map((item) => (
            <details id={item.id}>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
              {item.reference && (
                <p class="help-reference">
                  <a href={item.reference.href}>{item.reference.label}</a>
                </p>
              )}
            </details>
          ))}
        </section>
      </div>
    </main>
    <noscript>
      <p class="page-shell">
        JavaScript is required to create a favicon package locally. Enable
        JavaScript to use the generator.
      </p>
    </noscript>

    <script>
      import '../scripts/generator.ts';
    </script>
  </body>
</html>
